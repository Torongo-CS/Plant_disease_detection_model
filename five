# ============================================================
# PREPROCESSING
# ============================================================

def preprocess_image(
    rgb_image,
    input_details
):
    """
    Exact training preprocessing:

        RGB
        ->
        resize 224x224
        ->
        float32
        ->
        pixel / 255.0
        ->
        [1, 224, 224, 3]

    Quantized models are handled using their
    TFLite quantization parameters.
    """

    input_info = input_details[0]

    input_shape = tuple(
        input_info["shape"]
    )

    input_dtype = input_info["dtype"]


    # --------------------------------------------------------
    # Resize to exact model input size (224x224)
    # --------------------------------------------------------

    image = cv2.resize(
        rgb_image,
        (
            IMAGE_SIZE,
            IMAGE_SIZE
        ),
        interpolation=cv2.INTER_AREA
    )


    # --------------------------------------------------------
    # Image is guaranteed to be true RGB from camera_worker.
    # --------------------------------------------------------

    image = image.astype(
        np.float32
    )


    # --------------------------------------------------------
    # EXACT TRAINING NORMALIZATION
    # --------------------------------------------------------

    image = image / 255.0


    # --------------------------------------------------------
    # Add batch dimension -> [1, 224, 224, 3]
    # --------------------------------------------------------

    image = np.expand_dims(
        image,
        axis=0
    )


    # --------------------------------------------------------
    # FLOAT32 MODEL
    # --------------------------------------------------------

    if input_dtype == np.float32:

        tensor = image.astype(
            np.float32
        )


    # --------------------------------------------------------
    # UINT8 MODEL
    # --------------------------------------------------------

    elif input_dtype == np.uint8:

        scale, zero_point = (
            input_info["quantization"]
        )

        if scale == 0:

            raise RuntimeError(
                "Invalid uint8 quantization scale."
            )

        tensor = np.round(
            image / scale
            + zero_point
        )

        tensor = np.clip(
            tensor,
            0,
            255
        ).astype(
            np.uint8
        )


    # --------------------------------------------------------
    # INT8 MODEL
    # --------------------------------------------------------

    elif input_dtype == np.int8:

        scale, zero_point = (
            input_info["quantization"]
        )

        if scale == 0:

            raise RuntimeError(
                "Invalid int8 quantization scale."
            )

        tensor = np.round(
            image / scale
            + zero_point
        )

        tensor = np.clip(
            tensor,
            -128,
            127
        ).astype(
            np.int8
        )


    else:

        raise RuntimeError(
            f"Unsupported input dtype: "
            f"{input_dtype}"
        )


    # --------------------------------------------------------
    # Shape validation
    # --------------------------------------------------------

    if tuple(tensor.shape) != input_shape:

        raise RuntimeError(
            f"Input shape mismatch. "
            f"Expected {input_shape}, "
            f"got {tensor.shape}."
        )


    return tensor


# ============================================================
# OUTPUT DEQUANTIZATION
# ============================================================

def dequantize_output(
    output,
    output_details
):

    output_info = output_details[0]

    dtype = output_info["dtype"]


    if dtype in (
        np.uint8,
        np.int8
    ):

        scale, zero_point = (
            output_info["quantization"]
        )

        if scale != 0:

            output = (
                output.astype(
                    np.float32
                )
                - zero_point
            ) * scale

        else:

            output = output.astype(
                np.float32
            )

    else:

        output = output.astype(
            np.float32
        )


    return output


# ============================================================
# SOFTMAX
# ============================================================

def softmax(values):

    values = np.asarray(
        values,
        dtype=np.float32
    )

    values = (
        values
        - np.max(values)
    )

    exponentials = np.exp(
        values
    )

    total = np.sum(
        exponentials
    )

    if total <= 0:

        raise RuntimeError(
            "Softmax produced invalid output."
        )

    return (
        exponentials / total
    )


# ============================================================
# OUTPUT -> PROBABILITIES
# ============================================================

def output_to_probabilities(
    output
):

    output = np.asarray(
        output,
        dtype=np.float32
    )

    output = np.squeeze(
        output
    )

    output = output.reshape(
        -1
    )


    if len(output) != len(
        CLASS_NAMES
    ):

        raise RuntimeError(
            f"Model returned "
            f"{len(output)} outputs. "
            f"Expected "
            f"{len(CLASS_NAMES)}."
        )


    if not np.all(
        np.isfinite(output)
    ):

        raise RuntimeError(
            "Model produced NaN "
            "or infinite values."
        )


    output_sum = float(
        np.sum(output)
    )

    looks_like_probability = (
        np.all(output >= 0.0)
        and
        np.all(output <= 1.0)
        and
        abs(
            output_sum - 1.0
        ) < 0.05
    )


    if looks_like_probability:

        probabilities = output.copy()

    else:

        probabilities = softmax(
            output
        )


    probabilities = np.clip(
        probabilities,
        0.0,
        1.0
    )

    probability_sum = np.sum(
        probabilities
    )

    if probability_sum <= 0:

        raise RuntimeError(
            "Invalid probability distribution."
        )

    probabilities = (
        probabilities
        / probability_sum
    )


    return probabilities.astype(
        np.float32
    )


# ============================================================
# RUN ONE MODEL ON ACTUAL IMAGE
# ============================================================

def run_model(
    interpreter,
    input_details,
    output_details,
    rgb_image
):

    # 1. Preprocess captured RGB camera frame
    input_tensor = preprocess_image(
        rgb_image,
        input_details
    )


    # 2. Feed image tensor into TFLite interpreter
    interpreter.set_tensor(
        input_details[0]["index"],
        input_tensor
    )


    # 3. Run neural network inference
    interpreter.invoke()


    # 4. Extract output tensor
    raw_output = interpreter.get_tensor(
        output_details[0]["index"]
    )


    # 5. Dequantize if quantized
    raw_output = dequantize_output(
        raw_output,
        output_details
    )


    # 6. Convert raw outputs to softmax probabilities
    probabilities = (
        output_to_probabilities(
            raw_output
        )
    )


    return probabilities


# ============================================================
# ENSEMBLE PREDICTION
# ============================================================

def ensemble_prediction(
    rgb_image
):

    # MODEL 1 (MobileNetV3 Large)
    with model1_lock:

        probs1 = run_model(
            model1,
            model1_input_details,
            model1_output_details,
            rgb_image
        )


    # MODEL 2 (pd_v1)
    with model2_lock:

        probs2 = run_model(
            model2,
            model2_input_details,
            model2_output_details,
            rgb_image
        )


    # WEIGHTED ENSEMBLE (80% Model 1 + 20% Model 2)
    ensemble_probs = (
        MODEL_1_WEIGHT * probs1
        +
        MODEL_2_WEIGHT * probs2
    )


    # Normalize
    ensemble_probs = (
        ensemble_probs
        / np.sum(ensemble_probs)
    )


    # FINAL PREDICTION
    predicted_index = int(
        np.argmax(
            ensemble_probs
        )
    )

    predicted_class = (
        CLASS_NAMES[
            predicted_index
        ]
    )

    final_confidence = float(
        ensemble_probs[
            predicted_index
        ]
    )


    # INDIVIDUAL MODEL PREDICTIONS
    model1_index = int(
        np.argmax(probs1)
    )

    model2_index = int(
        np.argmax(probs2)
    )


    return {

        "class":
            predicted_class,

        "index":
            predicted_index,

        "confidence":
            final_confidence,

        "ensemble":
            ensemble_probs.tolist(),

        "model1":
            probs1.tolist(),

        "model2":
            probs2.tolist(),

        "model1_prediction":
            CLASS_NAMES[
                model1_index
            ],

        "model1_confidence":
            float(
                probs1[
                    model1_index
                ]
            ),

        "model2_prediction":
            CLASS_NAMES[
                model2_index
            ],

        "model2_confidence":
            float(
                probs2[
                    model2_index
                ]
            )
    }


