# ============================================================
# CAMERA WORKER
# ============================================================

def camera_worker():

    global latest_frame

    print("Camera worker started.")

    while True:

        try:

            # ------------------------------------------------
            # FIX FOR NEGATIVE / INVERTED RGB COLOURS:
            #
            # Picamera2's capture_array() returns BGR byte order 
            # in NumPy despite requesting "RGB888" format in 
            # libcamera backend. 
            # 
            # We explicitly convert BGR -> RGB right after capture 
            # so that latest_frame is ALWAYS clean, standard RGB.
            # ------------------------------------------------
            frame = camera.capture_array("main")

            if frame is not None and frame.ndim == 3:
                if frame.shape[2] == 4:
                    frame = cv2.cvtColor(frame, cv2.COLOR_BGRA2RGB)
                elif frame.shape[2] == 3:
                    frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

            with frame_lock:

                latest_frame = frame.copy()

        except Exception as e:

            print(
                "Camera error:",
                e
            )

            time.sleep(0.1)


camera_thread = threading.Thread(
    target=camera_worker,
    daemon=True
)

camera_thread.start()


