def validate_model(model_name, input_details, output_details):

    input_shape = tuple(
        input_details[0]["shape"]
    )

    output_shape = tuple(
        output_details[0]["shape"]
    )

    expected_input = (
        1,
        IMAGE_SIZE,
        IMAGE_SIZE,
        3
    )

    if input_shape != expected_input:

        raise RuntimeError(
            f"{model_name}: unexpected input shape "
            f"{input_shape}. Expected {expected_input}."
        )

    output_size = int(
        np.prod(output_shape)
    )

    if output_size != len(CLASS_NAMES):

        raise RuntimeError(
            f"{model_name}: expected "
            f"{len(CLASS_NAMES)} output values, "
            f"but model produces {output_size}."
        )


validate_model(
    "MobileNetV3",
    model1_input_details,
    model1_output_details
)

validate_model(
    "pd_v1",
    model2_input_details,
    model2_output_details
