    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 3px;
}

.class-bar {
    height: 6px;
    background: #162a1e;
    border-radius: 10px;
    overflow: hidden;
}

.class-bar-fill {
    height: 100%;
    background: #2fb344;
    width: 0%;
    transition: width 0.4s ease;
}

.class-bar-fill.active {
    background: #42c95a;
}

.small {
    color: #78907e;
    font-size: 12px;
    margin-top: 15px;
    line-height: 1.5;
}

@media(max-width: 900px) {
    .grid {
        grid-template-columns: 1fr;
    }
    .snapshot-container {
        flex-direction: column;
    }
    .snapshot-box {
        max-width: 100%;
    }
}
</style>
</head>

<body>

<div class="header">
    <h1>Plant Health Monitor</h1>
    <p>Raspberry Pi AI Plant Disease Ensemble Detection System</p>
</div>

<div class="container">
<div class="grid">

<!-- LEFT COLUMN -->
<div>
<div class="card">
    <div class="card-title">
        Live Raspberry Pi Camera Feed
    </div>

    <img class="camera" src="/video_feed" alt="Raspberry Pi Camera Feed">

    <button class="capture" id="captureButton" onclick="captureImage()">
        Capture & Diagnose Image
    </button>

    <div class="loading" id="loading">
        Analyzing camera frame with MobileNetV3 & pd_v1 neural networks...
    </div>
</div>

<!-- DIAGNOSIS RESULT -->
<div class="card result" id="result">
    <div class="card-title">
        Live Model Diagnosis
    </div>

    <div class="snapshot-container">
        <div class="snapshot-box">
            <img id="capturedPreview" class="snapshot-img" src="" alt="Captured Frame">
            <div class="snapshot-label">Captured Image Sent to AI</div>
        </div>

        <div class="result-header">
            <div class="result-name" id="disease">--</div>
            <div class="confidence" id="confidence">Ensemble confidence: --%</div>

            <div class="bar">
                <div class="bar-inner" id="confidenceBar"></div>
            </div>
        </div>
    </div>

    <p class="description" id="description"></p>

    <div class="actions">
        <strong>Recommended Actions:</strong>
        <ul id="actions"></ul>
    </div>

    <!-- Live 8-Class Probability Breakdown -->
    <div class="class-breakdown">
        <strong style="font-size: 15px; color: #e0eee4;">Full Ensemble Class Probabilities:</strong>
        <div id="classBreakdownList" style="margin-top: 10px;"></div>
    </div>

    <!-- AI Care Advice -->
    <div class="ai">
        <strong style="color: #42c95a;">AI Plant-Care Assistant Advice:</strong>
        <div id="aiAdvice" style="margin-top: 10px;">Waiting for diagnosis...</div>
    </div>
</div>
</div>

<!-- RIGHT COLUMN -->
<div>

<!-- Environment Card -->
<div class="card">
    <div class="card-title">Environment Data</div>
    <div class="stats">
        <div class="stat">
            <div class="stat-label">Temperature</div>
            <div class="stat-value" id="temperature">27.4C</div>
        </div>
        <div class="stat">
            <div class="stat-label">Humidity</div>
            <div class="stat-value" id="humidity">68%</div>
        </div>
        <div class="stat">
            <div class="stat-label">Time</div>
            <div class="stat-value" id="time">--</div>
        </div>
        <div class="stat">
            <div class="stat-label">Month</div>
            <div class="stat-value" id="month">--</div>
        </div>
    </div>
</div>

<!-- Neural Network Models Card -->
<div class="card" style="margin-top:20px">
    <div class="card-title">Live Model Predictions</div>

    <!-- Model 1 -->
    <div class="model-box">
        <div class="model-name">Model 1: MobileNetV3 Large</div>
        <div class="model-pred" id="m1_status">Waiting for capture...</div>
        <div class="model-meta">Weight: <strong>80%</strong> | Reported Acc: <strong>94%</strong></div>
    </div>

    <!-- Model 2 -->
    <div class="model-box">
        <div class="model-name">Model 2: pd_v1</div>
        <div class="model-pred" id="m2_status">Waiting for capture...</div>
        <div class="model-meta">Weight: <strong>20%</strong> | Reported Acc: <strong>68%</strong></div>
    </div>

    <div class="small">
        The system feeds the captured RGB camera frame into both TFLite models simultaneously. The predictions are combined using weighted probability averaging (80/20).
    </div>
</div>

</div>
</div>
</div>

<script>
// Class names matching python order
const CLASS_NAMES = [
    "Potato Early Blight",
    "Potato Late Blight",
    "Potato Healthy",
    "Tomato Early Blight",
    "Tomato Late Blight",
    "Tomato Leaf Mold",
    "Tomato Septoria",
    "Tomato Healthy"
];

function updateClock() {
    const now = new Date();
    document.getElementById("time").innerText = now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
    });
    document.getElementById("month").innerText = now.toLocaleString([], {
        month: "long"
    });
}
setInterval(updateClock, 1000);
updateClock();

async function captureImage() {
    const button = document.getElementById("captureButton");
    const loading = document.getElementById("loading");
    const result = document.getElementById("result");

    button.disabled = true;
    loading.style.display = "block";

    try {
        const response = await fetch("/predict", { method: "POST" });
        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Prediction failed.");
        }

        // 1. Display captured snapshot image
        if (data.image_b64) {
            document.getElementById("capturedPreview").src = data.image_b64;
        }

        // 2. Main Disease & Ensemble Confidence
        document.getElementById("disease").innerText = data.disease;
        document.getElementById("confidence").innerText = "Ensemble Confidence: " + data.confidence.toFixed(1) + "%";
        document.getElementById("confidenceBar").style.width = Math.min(data.confidence, 100) + "%";

        // 3. Description
        document.getElementById("description").innerText = data.description;

        // 4. Recommended Actions
        const actionsList = document.getElementById("actions");
        actionsList.innerHTML = "";
        data.actions.forEach(function(action) {
            const li = document.createElement("li");
            li.innerText = action;
            actionsList.appendChild(li);
        });

        // 5. Individual Live Model Predictions (Right Side Panel)
        document.getElementById("m1_status").innerText = data.model1_prediction + " (" + data.model1_confidence.toFixed(1) + "%)";
        document.getElementById("m2_status").innerText = data.model2_prediction + " (" + data.model2_confidence.toFixed(1) + "%)";

        // 6. Render Full 8-Class Probability Breakdown
        const breakdownContainer = document.getElementById("classBreakdownList");
        breakdownContainer.innerHTML = "";

        if (data.ensemble && data.ensemble.length === CLASS_NAMES.length) {
            CLASS_NAMES.forEach((className, idx) => {
                const probPct = (data.ensemble[idx] * 100).toFixed(1);
                const isWinner = (className === data.disease);

                const row = document.createElement("div");
                row.className = "class-row";
                row.innerHTML = `
                    <div class="class-info">
                        <span style="${isWinner ? 'font-weight:bold; color:#42c95a;' : 'color:#a0b8a8;'}">${className}</span>
                        <span style="${isWinner ? 'font-weight:bold; color:#42c95a;' : 'color:#a0b8a8;'}">${probPct}%</span>
                    </div>
                    <div class="class-bar">
                        <div class="class-bar-fill ${isWinner ? 'active' : ''}" style="width: ${probPct}%;"></div>
                    </div>
                `;
                breakdownContainer.appendChild(row);
            });
        }

        // 7. AI Advice
        document.getElementById("aiAdvice").innerText = data.ai_advice;

        // 8. Reveal Result Card
        result.style.display = "block";
        result.scrollIntoView({ behavior: "smooth", block: "start" });

    } catch(error) {
        alert("Prediction error:\n\n" + error.message);
    } finally {
        button.disabled = false;
        loading.style.display = "none";
    }
}
</script>

</body>
</html>
"""


# ============================================================
# HOME
# ============================================================

@app.route("/")
def index():

    return render_template_string(
        HTML
    )


# ============================================================
# CAMERA STREAM
# ============================================================

@app.route("/video_feed")
def video_feed():

    return Response(
        generate_camera_stream(),
        mimetype="multipart/x-mixed-replace; boundary=frame"
    )


# ============================================================
# PREDICTION ENDPOINT
# ============================================================

@app.route("/predict", methods=["POST"])
def predict():

    try:

        # ----------------------------------------------------
        # 1. Capture current live RGB frame from camera worker
        # ----------------------------------------------------
        frame = get_current_frame()

        if frame is None:
            return jsonify({
                "error": "Camera frame is not available."
            }), 500

        rgb_image = frame.copy()


        # ----------------------------------------------------
        # 2. Encode captured frame as base64 JPEG for snapshot preview
        # ----------------------------------------------------
        pil_img = Image.fromarray(rgb_image, "RGB")
        buf = BytesIO()
        pil_img.save(buf, format="JPEG", quality=85)
        img_b64 = base64.b64encode(buf.getvalue()).decode("utf-8")
        image_data_url = f"data:image/jpeg;base64,{img_b64}"


        # ----------------------------------------------------
        # 3. Run model ensemble inference on rgb_image
        # ----------------------------------------------------
        result = ensemble_prediction(rgb_image)

        disease = result["class"]
        confidence = result["confidence"] * 100

        info = DISEASE_INFO.get(
            disease,
            {
                "description": "The model detected a plant condition.",
                "actions": []
            }
        )

        # ----------------------------------------------------
        # 4. OpenRouter AI Advice
        # ----------------------------------------------------
        ai_advice = get_ai_advice(disease, confidence)


        # ----------------------------------------------------
        # 5. Return JSON with all live predictions & captured image
        # ----------------------------------------------------
        return jsonify({
            "image_b64": image_data_url,
            "disease": disease,
            "confidence": confidence,
            "description": info["description"],
            "actions": info["actions"],
            "ai_advice": ai_advice,
            "model1_prediction": result["model1_prediction"],
            "model1_confidence": result["model1_confidence"] * 100,
            "model2_prediction": result["model2_prediction"],
            "model2_confidence": result["model2_confidence"] * 100,
            "ensemble": result["ensemble"]
        })

    except Exception as e:

        print("Prediction error:", e)

        return jsonify({
            "error": str(e)
        }), 500


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    print("")
    print("=" * 65)
    print("RASPBERRY PI PLANT DISEASE DETECTION SYSTEM")
    print("=" * 65)

    print("\nCamera: RGB888 (Converted BGR->RGB)")
    print(f"Resolution: {CAMERA_WIDTH}x{CAMERA_HEIGHT}")
    print(f"Target FPS: {CAMERA_FPS}\n")

    print(f"Model 1: {MODEL_1_PATH} (Weight: {MODEL_1_WEIGHT})")
    print(f"Model 2: {MODEL_2_PATH} (Weight: {MODEL_2_WEIGHT})\n")

    if OPENROUTER_API_KEY:
        print("OpenRouter: CONFIGURED")
    else:
        print("OpenRouter: NOT CONFIGURED")

    print("\nDashboard: http://<RASPBERRY_PI_IP>:5000\n")
    print("=" * 65 + "\n")

    app.run(
        host="0.0.0.0",
        port=5000,
        threaded=True,
        debug=False
    )
