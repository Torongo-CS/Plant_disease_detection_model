            "%";


        result.style.display =
            "block";


        status.innerText =
            "Prediction completed";


    }

    catch(error) {


        console.error(error);


        status.innerHTML =
            '<span class="error">' +
            error.message +
            '</span>';


    }

    finally {

        button.disabled = false;

    }

}


</script>


</body>

</html>
"""


