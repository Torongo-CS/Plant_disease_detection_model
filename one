# ============================================================
# GET NEXT IMAGE NUMBER
# ============================================================

def get_next_image_number():

    files = os.listdir(
        CAPTURE_DIR
    )

    numbers = []

    for filename in files:

        if (
            filename.startswith("image_")
            and filename.lower().endswith(".jpg")
        ):

            number_text = filename[
                len("image_"):
                -len(".jpg")
            ]

            try:

                number = int(
                    number_text
                )

                numbers.append(
                    number
                )

            except ValueError:

                pass

    if not numbers:

        return 1

    return max(numbers) + 1


