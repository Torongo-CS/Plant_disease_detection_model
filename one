# ============================================================
# CAPTURE + PREDICT
# ============================================================

@app.route(
    "/capture",
    methods=["POST"]
)
def capture_and_predict():

    try:

        # ====================================================
        # VERY IMPORTANT
        #
        # Get ONE frame.
        #
        # This exact frame will be:
        #
        #   1. saved
        #   2. sent to the model
        #
        # ====================================================

        frame = get_current_frame()


        if frame is None:

            return jsonify({

                "success": False,

                "error":
                    "Camera frame is not available."

            }), 500


        # ====================================================
        # SAVE THAT EXACT FRAME
        # ====================================================

        filename, filepath = (
            save_frame(frame)
        )


        print("")
        print("=" * 60)

        print(
            "CAPTURED:",
            filename
        )

        print(
            "PATH:",
            filepath
        )


        # ====================================================
        # RUN AI ON THAT EXACT SAME FRAME
        # ====================================================

        print(
            "Running AI prediction..."
        )


        prediction = (
            ensemble_prediction(
                frame
            )
        )


        print(
            "Prediction:",
            prediction["class"]
        )

        print(
            "Confidence:",
            f"{prediction['confidence'] * 100:.2f}%"
        )

        print("=" * 60)


        # ====================================================
        # RETURN RESULT TO WEBSITE
        # ====================================================

        return jsonify({

            "success": True,

            "filename":
                filename,

            "result":
                prediction

        })


    except Exception as e:

        print(
            "[PREDICTION ERROR]",
            e
        )


        return jsonify({

            "success": False,

            "error":
                str(e)

        }), 500


# ============================================================
# SERVE CAPTURED IMAGE
# ============================================================

@app.route(
    "/captured/<filename>"
)
def captured_image(filename):

    filepath = os.path.join(
        CAPTURE_DIR,
        filename
    )


    # Security check:
    # only allow files inside CAPTURE_DIR

    filepath = os.path.abspath(
        filepath
    )

    capture_dir = os.path.abspath(
        CAPTURE_DIR
    )


    if not filepath.startswith(
        capture_dir + os.sep
    ):

        return (
            "Invalid filename",
            400
        )


    if not os.path.isfile(
        filepath
    ):

        return (
            "Image not found",
            404
        )


    from flask import send_file

    return send_file(
        filepath,
        mimetype="image/jpeg"
    )


