# ============================================================
# CAPTURE AND PREDICT
# ============================================================

@app.route(
    "/capture",
    methods=["POST"]
)
def capture_and_predict():

    try:

        # ----------------------------------------------------
        # GET ONE SPECIFIC FRAME
        # ----------------------------------------------------
        #
        # This is the critical part.
        #
        # The variable "frame" is used for BOTH:
        #
        #   1. Saving the image
        #   2. Running the model
        #
        # Therefore the model receives the exact image
        # that was captured.
        #
        # ----------------------------------------------------

        frame = get_current_frame()


        if frame is None:

            return jsonify({

                "success": False,

                "error":
                    "Camera frame is not available."

            }), 500


        # ----------------------------------------------------
        # SAVE EXACT FRAME
        # ----------------------------------------------------

        filename, filepath = save_frame(
            frame
        )


        print("")
        print("=" * 60)
        print("CAPTURED IMAGE")
        print("=" * 60)

        print(
            "Filename:",
            filename
        )

        print(
            "Path:",
            filepath
        )


        # ----------------------------------------------------
        # RUN MODELS ON THE EXACT SAME FRAME
        # ----------------------------------------------------

        print(
            "Running model prediction..."
        )


        prediction = ensemble_prediction(
            frame
        )


        print(
            "Prediction:",
            prediction["class"]
        )

        print(
            "Confidence:",
            f"{prediction['confidence'] * 100:.2f}%"
        )

        print("=" * 60)


        # ----------------------------------------------------
        # SEND RESULT TO WEBSITE
        # ----------------------------------------------------

        return jsonify({

            "success": True,

            "filename":
                filename,

            "result":
                prediction

        })


    except Exception as e:

        print(
            "[PREDICTION ERROR]",
            str(e)
        )


        return jsonify({

            "success": False,

            "error":
                str(e)

        }), 500


# ============================================================
# SERVE CAPTURED IMAGE
# ============================================================

@app.route(
    "/captured/<filename>"
)
def captured_image(filename):

    filepath = os.path.abspath(
        os.path.join(
            CAPTURE_DIR,
            filename
        )
    )

    capture_dir = os.path.abspath(
        CAPTURE_DIR
    )


    if not filepath.startswith(
        capture_dir + os.sep
    ):

        return (
            "Invalid filename",
            400
        )


    if not os.path.isfile(filepath):

        return (
            "Image not found",
            404
        )


    return send_file(
        filepath,
        mimetype="image/jpeg"
    )


