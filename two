def save_frame(frame):

    if frame is None:

        raise RuntimeError(
            "Camera frame is not available."
        )

    image_number = get_next_image_number()

    filename = (
        f"image_{image_number:04d}.jpg"
    )

    filepath = os.path.join(
        CAPTURE_DIR,
        filename
    )

    image = Image.fromarray(
        frame,
        "RGB"
    )

    image.save(
        filepath,
        format="JPEG",
        quality=95
    )

    return filename, filepath


# ============================================================
# PREPROCESSING
# ============================================================

def preprocess_image(
    rgb_image,
    input_details
):

    input_info = input_details[0]

    input_shape = tuple(
        input_info["shape"]
    )

    input_dtype = input_info["dtype"]


    # Resize

    image = cv2.resize(
        rgb_image,
        (
            IMAGE_SIZE,
            IMAGE_SIZE
        ),
        interpolation=cv2.INTER_AREA
    )


    # Convert to float

    image = image.astype(
        np.float32
    )


    # Normalize

    image = image / 255.0


    # Add batch dimension

    image = np.expand_dims(
        image,
        axis=0
    )


    # Float32

    if input_dtype == np.float32:

        tensor = image.astype(
            np.float32
        )


    # UINT8

    elif input_dtype == np.uint8:

        scale, zero_point = (
            input_info["quantization"]
        )

        if scale == 0:

            raise RuntimeError(
                "Invalid UINT8 quantization scale."
            )

        tensor = np.round(
            image / scale
            + zero_point
        )

        tensor = np.clip(
            tensor,
            0,
            255
        ).astype(
            np.uint8
        )


    # INT8

    elif input_dtype == np.int8:

        scale, zero_point = (
            input_info["quantization"]
        )

        if scale == 0:

            raise RuntimeError(
                "Invalid INT8 quantization scale."
            )

        tensor = np.round(
            image / scale
            + zero_point
        )

        tensor = np.clip(
            tensor,
            -128,
            127
        ).astype(
            np.int8
        )


    else:

        raise RuntimeError(
            f"Unsupported input dtype: "
            f"{input_dtype}"
        )


    if tuple(tensor.shape) != input_shape:

        raise RuntimeError(
            f"Input shape mismatch. "
            f"Expected {input_shape}, "
            f"got {tensor.shape}."
        )


    return tensor


# ============================================================
# OUTPUT DEQUANTIZATION
# ============================================================

def dequantize_output(
    output,
    output_details
):

    output_info = output_details[0]

    dtype = output_info["dtype"]


    if dtype in (
        np.uint8,
        np.int8
    ):

        scale, zero_point = (
            output_info["quantization"]
        )

        if scale != 0:

            output = (
                output.astype(np.float32)
                - zero_point
            ) * scale

        else:

            output = output.astype(
                np.float32
            )

    else:

        output = output.astype(
            np.float32
        )


    return output


# ============================================================
# SOFTMAX
# ============================================================

def softmax(values):

    values = np.asarray(
        values,
        dtype=np.float32
    )

    values = (
        values -
        np.max(values)
    )

    exponentials = np.exp(values)

    total = np.sum(exponentials)

    if total <= 0:

        raise RuntimeError(
            "Invalid softmax output."
        )

    return exponentials / total


# ============================================================
# OUTPUT TO PROBABILITIES
# ============================================================

def output_to_probabilities(output):

    output = np.asarray(
        output,
        dtype=np.float32
    )

    output = np.squeeze(output)

    output = output.reshape(-1)


    if len(output) != len(CLASS_NAMES):

        raise RuntimeError(
            f"Model returned {len(output)} "
            f"outputs. Expected "
            f"{len(CLASS_NAMES)}."
        )


    if not np.all(
        np.isfinite(output)
    ):

        raise RuntimeError(
            "Model produced invalid output."
        )


    output_sum = float(
        np.sum(output)
    )


    looks_like_probability = (

        np.all(output >= 0.0)
        and
        np.all(output <= 1.0)
        and
        abs(output_sum - 1.0) < 0.05
    )


    if looks_like_probability:

        probabilities = output.copy()

    else:

        probabilities = softmax(output)


    probabilities = np.clip(
        probabilities,
        0.0,
        1.0
    )


    total = np.sum(probabilities)

    if total <= 0:

        raise RuntimeError(
            "Invalid probability distribution."
        )


    probabilities = (
        probabilities / total
    )


    return probabilities.astype(
        np.float32
    )


# ============================================================
# RUN ONE MODEL
# ============================================================

def run_model(
    interpreter,
    input_details,
    output_details,
    rgb_image
):

    input_tensor = preprocess_image(
        rgb_image,
        input_details
    )


    interpreter.set_tensor(
        input_details[0]["index"],
        input_tensor
    )


    interpreter.invoke()


    raw_output = interpreter.get_tensor(
        output_details[0]["index"]
    )


    raw_output = dequantize_output(
        raw_output,
        output_details
    )


    probabilities = (
        output_to_probabilities(
            raw_output
        )
    )


    return probabilities


# ============================================================
# ENSEMBLE PREDICTION
# ============================================================
#
# rgb_image is the EXACT image captured by the button.
#
# ============================================================

def ensemble_prediction(rgb_image):


    # --------------------------------------------------------
    # MODEL 1
    # --------------------------------------------------------

    with model1_lock:

        probs1 = run_model(
            model1,
            model1_input_details,
            model1_output_details,
            rgb_image
        )


    # --------------------------------------------------------
    # MODEL 2
    # --------------------------------------------------------

    with model2_lock:

        probs2 = run_model(
            model2,
            model2_input_details,
            model2_output_details,
            rgb_image
        )


    # --------------------------------------------------------
    # WEIGHTED ENSEMBLE
    # --------------------------------------------------------

    ensemble_probs = (
        MODEL_1_WEIGHT * probs1
        +
        MODEL_2_WEIGHT * probs2
    )


    ensemble_probs = (
        ensemble_probs /
        np.sum(ensemble_probs)
    )


    # --------------------------------------------------------
    # FINAL CLASS
    # --------------------------------------------------------

    predicted_index = int(
        np.argmax(ensemble_probs)
    )

    predicted_class = (
        CLASS_NAMES[predicted_index]
    )

    final_confidence = float(
        ensemble_probs[predicted_index]
    )


    # --------------------------------------------------------
    # INDIVIDUAL MODEL RESULTS
    # --------------------------------------------------------

    model1_index = int(
        np.argmax(probs1)
    )

    model2_index = int(
        np.argmax(probs2)
    )


    return {

        "class":
            predicted_class,

        "index":
            predicted_index,

        "confidence":
            final_confidence,

        "ensemble":
            ensemble_probs.tolist(),

        "model1_prediction":
            CLASS_NAMES[model1_index],

        "model1_confidence":
            float(
                probs1[model1_index]
            ),

        "model2_prediction":
            CLASS_NAMES[model2_index],

        "model2_confidence":
            float(
                probs2[model2_index]
            )
    }


# ============================================================
# CAMERA STREAM
# ============================================================

def generate_camera_stream():

    while True:

        frame = get_current_frame()

        if frame is None:

            time.sleep(0.05)

            continue


        bgr_frame = cv2.cvtColor(
            frame,
            cv2.COLOR_RGB2BGR
        )


        success, buffer = cv2.imencode(
            ".jpg",
            bgr_frame,
            [
                cv2.IMWRITE_JPEG_QUALITY,
                JPEG_QUALITY
            ]
        )


        if not success:
            continue


        jpg = buffer.tobytes()


        yield (
            b"--frame\r\n"
            b"Content-Type: image/jpeg\r\n\r\n"
            + jpg
            + b"\r\n"
        )


