def validate_model(
    model_name,
    input_details,
    output_details
):

    input_shape = tuple(
        input_details[0]["shape"]
    )

    expected_shape = (
        1,
        IMAGE_SIZE,
        IMAGE_SIZE,
        3
    )

    if input_shape != expected_shape:

        raise RuntimeError(
            f"{model_name} input shape is "
            f"{input_shape}. Expected "
            f"{expected_shape}."
        )

    output_shape = tuple(
        output_details[0]["shape"]
    )

    output_size = int(
        np.prod(output_shape)
    )

    if output_size != len(CLASS_NAMES):

        raise RuntimeError(
            f"{model_name} produces "
            f"{output_size} outputs, but "
            f"{len(CLASS_NAMES)} classes are defined."
        )


